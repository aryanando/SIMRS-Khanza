<!-- Created with Jaspersoft Studio version 6.8.0.final using JasperReports Library version 6.8.0-2ed8dfabb690ff337a5797129f2cd92902b0c87b  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptCatatanRalan" language="javascript" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7a1c2e10-5b3d-4c8f-9a21-0d4e6f8a1b01">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="lokal"/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="no_rawat" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    reg.no_rawat,
    px.no_rkm_medis,
    px.nm_pasien,
    IF(px.jk='L','Laki-Laki','Perempuan') AS jk,
    px.umur,
    px.alamat,
    px.agama,
    kelurahan.nm_kel,
    kecamatan.nm_kec,
    kabupaten.nm_kab,
    propinsi.nm_prop,
    penjab.png_jawab,
    DATE_FORMAT(c.tanggal,'%d/%m/%Y') AS tgl_str,
    DATE_FORMAT(c.tanggal,'%H:%i') AS jam_str,
    DATE_FORMAT(c.tanggal,'%Y-%m-%d %H:%i:%s') AS tgl_lengkap,
    c.vital,
    c.soap,
    c.ie,
    c.nip,
    COALESCE(dok.nm_dokter, pt.nama, pg.nama, c.nip) AS nm_petugas
FROM (
    SELECT
        pr.no_rawat,
        TIMESTAMP(pr.tgl_perawatan, pr.jam_rawat) AS tanggal,
        CONCAT_WS('<br/>',
            CONCAT('<b>TD:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.tensi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>N:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.nadi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>S:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.suhu_tubuh,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>RR:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.respirasi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>Kesadaran:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(pr.kesadaran,'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>'))
        ) AS vital,
        CONCAT_WS('<br/>',
            CONCAT('<b>S:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.keluhan,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>O:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.pemeriksaan,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>A:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.penilaian,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>P:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.rtl,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>'))
        ) AS soap,
        CONCAT_WS('<br/>',
            CONCAT('<b>Instruksi:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.instruksi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>Evaluasi:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(pr.evaluasi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>'))
        ) AS ie,
        pr.nip
    FROM pemeriksaan_ranap AS pr
    WHERE pr.no_rawat = $P{no_rawat}

    UNION ALL

    SELECT
        ag.no_rawat,
        ag.tanggal,
        '<b>ADIME GIZI</b>' AS vital,
        CONCAT_WS('<br/>',
            CONCAT('<b>Asesmen:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(ag.asesmen,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>Diagnosis:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(ag.diagnosis,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>Intervensi:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(ag.intervensi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>Monitoring:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(ag.monitoring,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>'))
        ) AS soap,
        CONCAT_WS('<br/>',
            CONCAT('<b>Instruksi:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(ag.instruksi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>')),
            CONCAT('<b>Evaluasi:</b> ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NULLIF(ag.evaluasi,''),'&','&amp;'),'<','&lt;'),'>','&gt;'),CHAR(13),''),CHAR(10),'<br/>'))
        ) AS ie,
        ag.nip
    FROM catatan_adime_gizi AS ag
    WHERE ag.no_rawat = $P{no_rawat}
) AS c
INNER JOIN reg_periksa AS reg ON reg.no_rawat = c.no_rawat
INNER JOIN pasien AS px ON px.no_rkm_medis = reg.no_rkm_medis
LEFT JOIN penjab ON penjab.kd_pj = reg.kd_pj
LEFT JOIN kelurahan ON kelurahan.kd_kel = px.kd_kel
LEFT JOIN kecamatan ON kecamatan.kd_kec = px.kd_kec
LEFT JOIN kabupaten ON kabupaten.kd_kab = px.kd_kab
LEFT JOIN propinsi ON propinsi.kd_prop = px.kd_prop
LEFT JOIN dokter AS dok ON dok.kd_dokter = c.nip
LEFT JOIN petugas AS pt ON pt.nip = c.nip
LEFT JOIN pegawai AS pg ON pg.nik = c.nip
ORDER BY c.tanggal]]>
	</queryString>
