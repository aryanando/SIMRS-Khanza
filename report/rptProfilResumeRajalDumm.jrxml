	<detail>
		<band height="76" splitType="Prevent">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="20" height="76" uuid="c3000001-0000-4000-8000-000000000001"/>
