<!-- Created with Jaspersoft Studio version 6.8.0.final using JasperReports Library version 6.8.0-2ed8dfabb690ff337a5797129f2cd92902b0c87b  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptProfilResumeRajal" language="javascript" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0f505995-42c1-4cc5-b34d-0896041d3a11">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="lokal"/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="no_rkm_medis" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    px.no_rkm_medis,
    px.nm_pasien,
    IF(px.jk='L','Laki-Laki','Perempuan') AS jk,
    px.umur,
    kelurahan.nm_kel,
    kecamatan.nm_kec,
    kabupaten.nm_kab,
    propinsi.nm_prop,
    px.alamat,
    px.agama,
    reg.tgl_registrasi,
    ralan.penilaian,
    ralan.alergi,
    ralan.rtl,
    ralan.instruksi,
    ralan.nip,
    dok.nm_dokter,
    penjab.png_jawab,

    (
        SELECT ki.tgl_masuk
        FROM kamar_inap AS ki
        INNER JOIN reg_periksa AS reg_ranap
            ON reg_ranap.no_rawat = ki.no_rawat
        WHERE reg_ranap.no_rkm_medis = reg.no_rkm_medis
          AND ki.tgl_masuk < reg.tgl_registrasi
        ORDER BY ki.tgl_masuk DESC, ki.jam_masuk DESC
        LIMIT 1
    ) AS riwayat_ranap,

    CASE
        WHEN (
            SELECT COUNT(*)
            FROM reg_periksa AS kunjungan
            WHERE kunjungan.no_rkm_medis = reg.no_rkm_medis
              AND kunjungan.tgl_registrasi >= (
                  SELECT DATE(o.tgl_operasi)
                  FROM operasi AS o
                  INNER JOIN reg_periksa AS rp
                      ON rp.no_rawat = o.no_rawat
                  WHERE rp.no_rkm_medis = reg.no_rkm_medis
                    AND rp.status_lanjut = 'Ranap'
                    AND o.tgl_operasi < reg.tgl_registrasi
                  ORDER BY o.tgl_operasi DESC
                  LIMIT 1
              )
              AND kunjungan.tgl_registrasi <= reg.tgl_registrasi
        ) <= 3

        THEN (
            SELECT CONCAT(
                GROUP_CONCAT(
                    DISTINCT TRIM(
                        SUBSTRING_INDEX(po.nm_perawatan, '(', 1)
                    )
                    SEPARATOR ', '
                ),
                ' (',
                DATE_FORMAT(MAX(o.tgl_operasi), '%d-%m-%Y'),
                ')'
            )
            FROM operasi AS o
            INNER JOIN paket_operasi AS po
                ON po.kode_paket = o.kode_paket
            INNER JOIN reg_periksa AS rp
                ON rp.no_rawat = o.no_rawat
            WHERE rp.no_rkm_medis = reg.no_rkm_medis
              AND rp.status_lanjut = 'Ranap'
              AND o.tgl_operasi < reg.tgl_registrasi
              AND o.tgl_operasi = (
                  SELECT MAX(o2.tgl_operasi)
                  FROM operasi AS o2
                  INNER JOIN reg_periksa AS rp2
                      ON rp2.no_rawat = o2.no_rawat
                  WHERE rp2.no_rkm_medis = reg.no_rkm_medis
                    AND rp2.status_lanjut = 'Ranap'
                    AND o2.tgl_operasi < reg.tgl_registrasi
              )
        )

        ELSE ''
    END AS riwayat_bedah

FROM reg_periksa AS reg

INNER JOIN pasien AS px
    ON px.no_rkm_medis = reg.no_rkm_medis

LEFT JOIN pemeriksaan_ralan AS ralan
    ON ralan.no_rawat = reg.no_rawat

INNER JOIN dokter AS dok
    ON dok.kd_dokter = ralan.nip

INNER JOIN penjab
    ON penjab.kd_pj = reg.kd_pj

INNER JOIN kelurahan
    ON kelurahan.kd_kel = px.kd_kel

INNER JOIN kecamatan
    ON kecamatan.kd_kec = px.kd_kec

INNER JOIN kabupaten
    ON kabupaten.kd_kab = px.kd_kab

INNER JOIN propinsi
    ON propinsi.kd_prop = px.kd_prop

WHERE reg.no_rkm_medis = $P{no_rkm_medis}

ORDER BY reg.tgl_registrasi DESC]]>
	</queryString>
	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="jk" class="java.lang.String"/>
	<field name="umur" class="java.lang.String"/>
	<field name="nm_kel" class="java.lang.String"/>
	<field name="nm_kec" class="java.lang.String"/>
	<field name="nm_kab" class="java.lang.String"/>
