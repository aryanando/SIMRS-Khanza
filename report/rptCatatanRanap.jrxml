<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptCatatanRanap" language="javascript" pageWidth="650" pageHeight="842" columnWidth="610" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7a1c2e10-5b3d-4c8f-9a21-0d4e6f8a1b01">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="lokal"/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="no_rawat" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    reg.no_rawat,
    px.no_rkm_medis,
    px.nm_pasien,
    IF(px.jk='L','Laki-Laki','Perempuan') AS jk,
    px.umur,
    px.alamat,
    px.agama,
    kelurahan.nm_kel,
    kecamatan.nm_kec,
    kabupaten.nm_kab,
    propinsi.nm_prop,
    penjab.png_jawab,
    DATE_FORMAT(c.tanggal,'%d/%m/%Y') AS tgl_str,
    DATE_FORMAT(c.tanggal,'%H:%i') AS jam_str,
    DATE_FORMAT(c.tanggal,'%Y-%m-%d %H:%i:%s') AS tgl_lengkap,
    c.jenis,
    c.vital,
    c.l1, c.v1, c.l2, c.v2, c.l3, c.v3,
    c.l4, c.v4, c.l5, c.v5, c.l6, c.v6,
    c.nip,
    COALESCE(dok.nm_dokter, pt.nama, pg.nama, c.nip) AS nm_petugas,
    vf.status_verifikasi,
    COALESCE(dv.nm_dokter, pv.nama, vf.nip_verifikator) AS nm_verifikator,
    DATE_FORMAT(vf.tanggal_verifikasi,'%d/%m/%Y %H:%i') AS tgl_verifikasi_str
FROM (
    SELECT
        pr.no_rawat,
        TIMESTAMP(pr.tgl_perawatan, pr.jam_rawat) AS tanggal,
        pr.tgl_perawatan,
        pr.jam_rawat,
        'ranap' AS jenis_pelayanan,
        'CPPT' AS jenis,
        NULLIF(CONCAT_WS(', ',
            CONCAT('TD: ', NULLIF(TRIM(pr.tensi),'')),
            CONCAT('N: ', NULLIF(TRIM(pr.nadi),'')),
            CONCAT('S: ', NULLIF(TRIM(pr.suhu_tubuh),'')),
            CONCAT('RR: ', NULLIF(TRIM(pr.respirasi),'')),
            CONCAT('Kesadaran: ', pr.kesadaran)
        ),'') AS vital,
        'Subjek :' AS l1,
        NULLIF(TRIM(pr.keluhan),'') AS v1,
        'Objek :' AS l2,
        NULLIF(TRIM(pr.pemeriksaan),'') AS v2,
        'Asesmen :' AS l3,
        NULLIF(TRIM(pr.penilaian),'') AS v3,
        'Plan :' AS l4,
        NULLIF(TRIM(pr.rtl),'') AS v4,
        'Instruksi :' AS l5,
        NULLIF(TRIM(pr.instruksi),'') AS v5,
        'Evaluasi :' AS l6,
        NULLIF(TRIM(pr.evaluasi),'') AS v6,
        pr.nip
    FROM pemeriksaan_ranap AS pr
    WHERE pr.no_rawat = $P{no_rawat}

    UNION ALL

    SELECT
        pl.no_rawat,
        TIMESTAMP(pl.tgl_perawatan, pl.jam_rawat) AS tanggal,
        pl.tgl_perawatan,
        pl.jam_rawat,
        'ralan' AS jenis_pelayanan,
        'CPPT RALAN / IGD' AS jenis,
        NULLIF(CONCAT_WS(', ',
            CONCAT('TD: ', NULLIF(TRIM(pl.tensi),'')),
            CONCAT('N: ', NULLIF(TRIM(pl.nadi),'')),
            CONCAT('S: ', NULLIF(TRIM(pl.suhu_tubuh),'')),
            CONCAT('RR: ', NULLIF(TRIM(pl.respirasi),'')),
            CONCAT('Kesadaran: ', pl.kesadaran)
        ),'') AS vital,
        'Subjek :' AS l1,
        NULLIF(TRIM(pl.keluhan),'') AS v1,
        'Objek :' AS l2,
        NULLIF(TRIM(pl.pemeriksaan),'') AS v2,
        'Asesmen :' AS l3,
        NULLIF(TRIM(pl.penilaian),'') AS v3,
        'Plan :' AS l4,
        NULLIF(TRIM(pl.rtl),'') AS v4,
        'Instruksi :' AS l5,
        NULLIF(TRIM(pl.instruksi),'') AS v5,
        'Evaluasi :' AS l6,
        NULLIF(TRIM(pl.evaluasi),'') AS v6,
        pl.nip
    FROM pemeriksaan_ralan AS pl
    WHERE pl.no_rawat = $P{no_rawat}

    UNION ALL

    SELECT
        ag.no_rawat,
        ag.tanggal,
        NULL AS tgl_perawatan,
        NULL AS jam_rawat,
        NULL AS jenis_pelayanan,
        'ADIME GIZI' AS jenis,
        NULL AS vital,
        'Asesmen :' AS l1,
        NULLIF(TRIM(ag.asesmen),'') AS v1,
        'Diagnosis :' AS l2,
        NULLIF(TRIM(ag.diagnosis),'') AS v2,
        'Intervensi :' AS l3,
        NULLIF(TRIM(ag.intervensi),'') AS v3,
        'Monitoring :' AS l4,
        NULLIF(TRIM(ag.monitoring),'') AS v4,
        'Instruksi :' AS l5,
        NULLIF(TRIM(ag.instruksi),'') AS v5,
        'Evaluasi :' AS l6,
        NULLIF(TRIM(ag.evaluasi),'') AS v6,
        ag.nip
    FROM catatan_adime_gizi AS ag
    WHERE ag.no_rawat = $P{no_rawat}
) AS c
INNER JOIN reg_periksa AS reg ON reg.no_rawat = c.no_rawat
INNER JOIN pasien AS px ON px.no_rkm_medis = reg.no_rkm_medis
LEFT JOIN penjab ON penjab.kd_pj = reg.kd_pj
LEFT JOIN kelurahan ON kelurahan.kd_kel = px.kd_kel
LEFT JOIN kecamatan ON kecamatan.kd_kec = px.kd_kec
LEFT JOIN kabupaten ON kabupaten.kd_kab = px.kd_kab
LEFT JOIN propinsi ON propinsi.kd_prop = px.kd_prop
LEFT JOIN dokter AS dok ON dok.kd_dokter = c.nip
LEFT JOIN petugas AS pt ON pt.nip = c.nip
LEFT JOIN pegawai AS pg ON pg.nik = c.nip
LEFT JOIN (
    SELECT v.no_rawat, v.tgl_perawatan, v.jam_rawat, v.jenis_pelayanan,
           v.status_verifikasi, v.nip_verifikator, v.tanggal_verifikasi
    FROM verifikasi_soap AS v
    INNER JOIN (
        SELECT MAX(id_verifikasi) AS id_verifikasi
        FROM verifikasi_soap
        WHERE no_rawat = $P{no_rawat}
        GROUP BY no_rawat, tgl_perawatan, jam_rawat, jenis_pelayanan
    ) AS m ON m.id_verifikasi = v.id_verifikasi
) AS vf ON vf.no_rawat = c.no_rawat
       AND vf.tgl_perawatan = c.tgl_perawatan
       AND vf.jam_rawat = c.jam_rawat
       AND vf.jenis_pelayanan = c.jenis_pelayanan
LEFT JOIN dokter AS dv ON dv.kd_dokter = vf.nip_verifikator
LEFT JOIN pegawai AS pv ON pv.nik = vf.nip_verifikator
ORDER BY c.tanggal]]>
	</queryString>
